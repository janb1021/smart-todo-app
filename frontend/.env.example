# ==========================================
# 智能代办助手 - 前端环境变量模板
# ==========================================
# 复制此文件为 .env 并填入实际值
# 命令: cp .env.example .env

# ------------------------------------------
# API 基础地址
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api

# ------------------------------------------
# 应用配置
# ------------------------------------------
# 应用标题
VITE_APP_TITLE=智能代办助手

# 默认分页大小
VITE_DEFAULT_PAGE_SIZE=10

# ------------------------------------------
# 功能开关（可选）
# ------------------------------------------
# 启用 AI 智能解析功能 (true/false)
VITE_ENABLE_AI_PARSE=true

# 启用数据看板 (true/false)
VITE_ENABLE_DASHBOARD=true

# 调试模式 (true/false)
VITE_DEBUG=false
